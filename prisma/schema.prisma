generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  username     String   @id
  displayName  String?
  bio          String   @default("Ola, sou um desenvolvedor entusiasta!")
  location     String   @default("")
  relationship String   @default("Solteiro(a)")
  birthday     String   @default("")
  theme        String   @default("classic")
  profileColor String   @default("#D9E6F6")
  mood         String   @default("feliz")
  statusText   String   @default("")
  verified     Boolean  @default(false)
  createdAt    DateTime @default(now())
}

model LoginChallenge {
  id        String   @id @default(uuid())
  username  String
  code      String
  createdAt DateTime @default(now())
  expiresAt DateTime
}

model Community {
  id          String   @id @default(uuid())
  title       String
  imageUrl    String
  paginaUrl   String
  creatorId   String?
  description String   @default("")
  category    String   @default("Geral")
  createdAt   DateTime @default(now())
}

model CommunityMember {
  id          String   @id @default(uuid())
  userId      String
  communityId String
  createdAt   DateTime @default(now())

  @@unique([userId, communityId])
}

model Scrap {
  id         String   @id @default(uuid())
  senderId   String
  receiverId String
  text       String
  createdAt  DateTime @default(now())
}

model CachedProfile {
  username   String   @id
  avatarUrl  String
  totalStars Int      @default(0)
  totalRepos Int      @default(0)
  reposData  String
  updatedAt  DateTime @updatedAt
}

model Follow {
  id          String   @id @default(uuid())
  followerId  String
  followingId String
  createdAt   DateTime @default(now())

  @@unique([followerId, followingId])
}

model FriendRequest {
  id        String   @id @default(uuid())
  fromId    String
  toId      String
  status    String   @default("pending")
  createdAt DateTime @default(now())

  @@unique([fromId, toId])
}

model BadgeVote {
  id         String   @id @default(uuid())
  senderId   String
  receiverId String
  badgeType  String
  createdAt  DateTime @default(now())

  @@unique([senderId, receiverId, badgeType])
}

model Testimonial {
  id         String   @id @default(uuid())
  senderId   String
  receiverId String
  text       String
  isPublic   Boolean  @default(false)
  createdAt  DateTime @default(now())
}

model CommunityTopic {
  id          String   @id @default(uuid())
  title       String
  authorId    String
  communityId String
  createdAt   DateTime @default(now())
}

model CommunityPost {
  id        String   @id @default(uuid())
  text      String
  authorId  String
  topicId   String
  createdAt DateTime @default(now())
}

model Activity {
  id         String   @id @default(uuid())
  actorId    String
  type       String
  targetId   String?
  targetName String?
  extra      String?
  createdAt  DateTime @default(now())
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  actorId   String
  type      String
  message   String
  link      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Album {
  id        String   @id @default(uuid())
  ownerId   String
  title     String
  createdAt DateTime @default(now())
}

model Photo {
  id        String   @id @default(uuid())
  albumId   String
  imageUrl  String
  caption   String?
  createdAt DateTime @default(now())
}

model Quiz {
  id        String   @id @default(uuid())
  ownerId   String
  title     String
  questions String
  createdAt DateTime @default(now())
}

model QuizAnswer {
  id        String   @id @default(uuid())
  quizId    String
  userId    String
  answers   String
  score     Int      @default(0)
  createdAt DateTime @default(now())

  @@unique([quizId, userId])
}

model DirectMessage {
  id        String   @id @default(uuid())
  fromId    String
  toId      String
  text      String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}

model ProfileVisit {
  id        String   @id @default(uuid())
  visitorId String
  visitedId String
  createdAt DateTime @default(now())
}

model Video {
  id        String   @id @default(uuid())
  ownerId   String
  title     String
  url       String
  createdAt DateTime @default(now())
}

model Gift {
  id         String   @id @default(uuid())
  senderId   String
  receiverId String
  giftType   String
  message    String  @default("")
  createdAt  DateTime @default(now())
}

model SocialEvent {
  id          String   @id @default(uuid())
  creatorId   String
  title       String
  description String   @default("")
  place       String   @default("")
  happensAt   String
  createdAt   DateTime @default(now())
}

model EventRsvp {
  id        String   @id @default(uuid())
  eventId   String
  userId    String
  status    String   @default("yes")
  createdAt DateTime @default(now())

  @@unique([eventId, userId])
}
